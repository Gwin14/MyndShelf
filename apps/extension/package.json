{
  "name": "@myndshelf/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit -p .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@myndshelf/core": "workspace:*",
    "@myndshelf/design-tokens": "workspace:*",
    "@myndshelf/sync": "workspace:*",
    "@myndshelf/types": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@myndshelf/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.9.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
