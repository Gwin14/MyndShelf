{
  "expo": {
    "name": "MyndShelf",
    "slug": "myndshelf",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/app-icons/MindShelf.png",
    "scheme": "myndshelf",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#06050b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myndshelf.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.myndshelf.app"
        ]
      },
      "icon": "./assets/app-icons/MindShelf.icon"
    },
    "android": {
      "package": "com.myndshelf.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/app-icons/MindShelf-android.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06050b",
          "image": "./assets/splash/splash.png",
          "imageWidth": 230,
          "android": {
            "image": "./assets/app-icons/Emblema-android.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-audio",
      [
        "./plugins/withAlternateIconFiles",
        [
          "./assets/app-icons/Cosmos.icon",
          "./assets/app-icons/Emblema.icon"
        ]
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Cosmos",
            "android": {
              "foregroundImage": "./assets/app-icons/Cosmos-android.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Emblema",
            "android": {
              "foregroundImage": "./assets/app-icons/Emblema-android.png",
              "backgroundColor": "#000000"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
